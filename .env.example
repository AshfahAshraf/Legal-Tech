# =============================================================
# LegalTech — Environment Variables Template
# =============================================================
# This file is safe to commit to git — it contains NO secrets.
# Copy to .env.local (development) or .env.production (production)
# and fill in the real values.
# =============================================================

# ── Database ─────────────────────────────────────────────────
DB_NAME=legaltech_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=shared-mysql
DB_PORT=3306
DATABASE_URL=mysql+pymysql://root:your_mysql_password@shared-mysql:3306/legaltech_db

# ── Security ─────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_very_strong_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ── Frontend API URL ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Email (Optional) ─────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SENDER_EMAIL=your_email@gmail.com

# ── Razorpay (Required for payments) ─────────────────────────
RAZORPAY_KEY_ID=rzp_live_or_test_XXXXXXXXXXXX
RAZORPAY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXX
