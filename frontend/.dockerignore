# Node.js dependencies (large — never include in image)
node_modules/

# Next.js build output (rebuilt inside Docker)
.next/
out/

# Environment files (never bake secrets into the image)
.env
.env.*
!.env.example

# Test and lint outputs
*.log
lint_output.txt

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# README / docs (not needed in image)
README.md
CLAUDE.md
AGENTS.md
